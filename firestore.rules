rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isTeacher() {
      // ЗАМІНІТЬ на свою пошту (ту саму, що в js/firebase-config.js)
      return request.auth != null && request.auth.token.email == "yurchenko09@gmail.com";
    }
    // Налаштування (групи, відкриті теми, дедлайни): читають усі, змінює лише викладач
    match /config/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // Ключі відповідей: лише викладач
    match /keys/{topic} {
      allow read, write: if isTeacher();
    }
    // Спроби студентів: кожен бачить і змінює лише свою (прив'язка до браузера),
    // викладач — усі. Якщо викладач «відв'язав» пристрій (uid = null), спробу можна продовжити з іншого.
    match /attempts/{id} {
      allow read: if isTeacher()
        || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid || resource.data.uid == null));
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['topic','group','name']);
      allow update: if isTeacher()
        || (request.auth != null && request.resource.data.uid == request.auth.uid
            && (resource.data.uid == request.auth.uid || resource.data.uid == null)
            && resource.data.done != true);
      allow delete: if isTeacher();
    }
  }
}
